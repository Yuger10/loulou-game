{
  // ADR 0003, étape 2 : le mode strict, couche par couche, du bas vers le haut.
  // Une couche entre dans `include` quand elle est propre (app en dernier : elle importe features) ; à la fin, `strict: true`
  // passe dans tsconfig.json et ce fichier disparaît (track typescript-checkjs).
  "extends": "./tsconfig.json",
  "compilerOptions": { "strict": true },
  "include": [
    "js/shared/**/*.js",
    "js/entities/**/*.js",
    "js/features/wallet/**/*.js",
    "js/features/gains/**/*.js",
    "js/features/screen/**/*.js",
    "js/features/hints/**/*.js",
    "js/features/adaptive/**/*.js",
    "js/features/music/**/*.js",
    "js/features/party/**/*.js",
    "js/features/squishies/**/*.js",
    "js/features/story/**/*.js",
    "js/features/wardrobe/**/*.js",
    "js/features/bag/**/*.js",
    "js/features/quests/**/*.js",
    "js/features/seasons/**/*.js",
    "js/features/profile/**/*.js",
    "js/features/gifts/**/*.js",
    "js/features/island/**/*.js",
    "js/features/companion-team/**/*.js",
    "js/features/map/**/*.js",
    "js/features/minigame-engine/**/*.js",
    "js/features/minigames/memory/**/*.js",
    "js/features/minigames/count/**/*.js",
    "js/features/minigames/intruder/**/*.js",
    "js/features/minigames/simon/**/*.js",
    "js/features/minigames/sequence/**/*.js",
    "js/features/minigames/puzzle/**/*.js",
    "js/features/minigames/math/**/*.js",
    "js/features/minigames/reading/**/*.js",
    "js/features/minigames/grammar/**/*.js",
    "js/features/minigames/volume/**/*.js",
    "js/features/minigames/compare/**/*.js",
    "js/features/minigames/money/**/*.js",
    "js/features/minigames/clock/**/*.js",
    "js/features/minigames/calendar/**/*.js",
    "js/features/minigames/calc/**/*.js",
    "js/features/minigames/shapes/**/*.js",
    "js/features/minigames/planets/**/*.js",
    "js/features/minigames/jigsaw/**/*.js",
    "types/**/*.d.ts"
  ]
}
