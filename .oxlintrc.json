{
  // Lint du projet (factory, phase 1 ; stack de référence cothon). Décisions : docs/factory/SPEED.md.
  // Les règles "off" ci-dessous sont provisoires : la track conductor/tracks/lint-regles-completes_20261121 les réactive en corrigeant le code.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error", "suspicious": "error" },
  "env": { "browser": true, "node": true, "es2022": true },
  "rules": {
    // un paramètre imposé par une signature mais inutile se préfixe par _
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    // `el.onclick = ...` est l'idiome du projet : réaffecté à chaque rendu, sans doublon de handler
    "unicorn/prefer-add-event-listener": "off",
    // toSorted et toReversed demandent Safari 16 : les tablettes des enfants sont souvent plus anciennes
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // style seulement, sans risque de bug
    "unicorn/consistent-function-scoping": "off",
    // propriétés posées exprès sur des éléments du DOM (el._last, el._t)
    "no-underscore-dangle": "off",
    // anti-pattern 2 : tout tirage passe par random() de js/shared/lib (graine fixable en test)
    "no-restricted-properties": [
      "error",
      { "object": "Math", "property": "random", "message": "Utiliser random() (ou pickRandom, shuffle) de js/shared/lib : une seule source de hasard, rejouable en test." },
      // anti-pattern 3 : une écriture ratée ne doit jamais passer inaperçue
      { "object": "localStorage", "property": "setItem", "message": "Utiliser storageWrite() de js/shared/lib : elle signale un enregistrement raté (message, espace parents)." },
      { "object": "localStorage", "property": "removeItem", "message": "Utiliser storageRemove() de js/shared/lib : elle signale un échec." }
    ],
    // anti-pattern 3 : un bloc vide dit pourquoi, dans un commentaire (catch { /* raison */ })
    "no-empty": "error"
  },
  "overrides": [
    // la seule source de hasard, et les tests qui forcent un tirage en remplaçant Math.random
    { "files": ["js/shared/lib/random.js", "js/shared/lib/storage.js", "test/**"], "rules": { "no-restricted-properties": "off" } }
  ],
  "ignorePatterns": ["node_modules/**"]
}
