{
  "name": "lagon-magique",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "check": "node test/tools/lockfile.js && bun run lint && bun run typecheck && bun run docs && bun run test",
    "lint": "oxlint --deny-warnings js test && oxfmt --check js test",
    "format": "oxfmt js test",
    "typecheck": "tsc -p .",
    "docs": "bash test/tools/check-docs.sh",
    "start": "python3 -m http.server 8080",
    "test": "node test/tools/run.js",
    "test:holdout": "node test/tools/run.js --holdout",
    "verify": "bun run check && bun run test:holdout",
    "inventaire": "node test/tools/globals.js $(node -e \"console.log(require('./js/slices.cjs').SLICES.flatMap(s=>s.files).join(' '))\")",
    "sync": "node test/tools/sync.js",
    "sw": "node test/tools/sync.js",
    "prepare": "lefthook install",
    "release": "node test/tools/release.js"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.24.0",
    "jsdom": "^26.0.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
