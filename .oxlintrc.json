{
  // Lint du projet (factory, phase 1 ; stack de référence cothon). Décisions : docs/factory/SPEED.md.
  // Les règles "off" ci-dessous sont provisoires : la track conductor/tracks/lint-regles-completes_20261121 les réactive en corrigeant le code.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "oxc", "typescript", "import"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "env": { "browser": true, "node": true, "es2022": true },
  "rules": {
    // un paramètre imposé par une signature mais inutile se préfixe par _
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    // un handler passe par setHandler (js/shared/ui/handlers.js) : addEventListener, sans doublon
    "unicorn/prefer-add-event-listener": "error",
    // décision d'Amrou : le jeu doit marcher partout (c'est pourquoi il est en HTML) ; ces règles
    // imposent toSorted et toReversed (Safari 16), donc elles restent coupées et `.sort()` reste
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    // gardée coupée (décision écrite, track lint-regles-completes) : sortir les 50 petites fonctions
    // internes créerait des noms de haut niveau en double (5 `key`, 4 `ok`), interdits par
    // test/slices.test.js parce que les tests lisent le jeu par nom ; gain de style seulement
    "unicorn/consistent-function-scoping": "off",
    "no-underscore-dangle": "error",
    // anti-pattern 2 : tout tirage passe par random() de js/shared/lib (graine fixable en test)
    "no-restricted-properties": [
      "error",
      { "object": "Math", "property": "random", "message": "Utiliser random() (ou pickRandom, shuffle) de js/shared/lib : une seule source de hasard, rejouable en test." },
      // anti-pattern 3 : une écriture ratée ne doit jamais passer inaperçue
      { "object": "localStorage", "property": "setItem", "message": "Utiliser storageWrite() de js/shared/lib : elle signale un enregistrement raté (message, espace parents)." },
      { "object": "localStorage", "property": "removeItem", "message": "Utiliser storageRemove() de js/shared/lib : elle signale un échec." }
    ],
    // anti-pattern 3 : un bloc vide dit pourquoi, dans un commentaire (catch { /* raison */ })
    "no-empty": "error",
    // track lint-regles-completes : règles ajoutées pour ce projet (coût mesuré : < 1 ms)
    // `x == null` (null ou undefined) reste permis, c'est l'idiome du projet
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    // seulement les vrais risques d'ordre d'initialisation des modules (même portée)
    "no-use-before-define": ["error", { "functions": false, "classes": false, "variables": false }],
    // rien dans la console du jeu (les tests restent libres, voir overrides)
    "no-console": "error",
    // cliquet : aucun fichier ne dépasse le plus gros actuel ; à abaisser vers 800
    "max-lines": ["error", { "max": 1250 }],
    // une valeur par défaut s'écrit dans la signature (rng = random), ou dans une variable locale
    "no-param-reassign": "error",
    // un cycle d'imports peut lire une valeur pas encore définie au démarrage des modules ES
    "import/no-cycle": "error",
    // main.js charge les slices par import à effet, et un mini-jeu s'y enregistre (ADR 0002)
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    // la seule source de hasard, et les tests qui forcent un tirage en remplaçant Math.random
    { "files": ["js/shared/lib/random.js", "js/shared/lib/storage.js", "test/**"], "rules": { "no-restricted-properties": "off" } },
    // les tests affichent leurs résultats, et la suite de fumée est longue par nature
    { "files": ["test/**"], "rules": { "no-console": "off", "max-lines": "off" } }
  ],
  "ignorePatterns": ["node_modules/**"]
}
